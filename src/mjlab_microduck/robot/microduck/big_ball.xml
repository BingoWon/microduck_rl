<mujoco model="microduck_big_ball">
    <compiler angle="radian" autolimits="true"/>

    <worldbody>
        <!-- 60cm-diameter circus ball for the BallWalk task. Sized like a
             large exercise ball: 1.0 kg hollow shell, inertia = (2/3) m r^2
             = 0.06 kg m^2. The robot (0.8 kg) stands on top and rolls it.
             friction = (sliding, torsional, rolling): high sliding so the
             feet grip and the ball rolls on the floor instead of skating;
             condim=6 activates the torsional + rolling terms so the ball has
             a little rolling resistance and doesn't coast forever (a
             frictionless-rolling ball is uncontrollable by a 0.8 kg rider).
             NOTE: foot-ball contacts use the FOOT geom's params (feet have
             priority=1 in FULL_COLLISION), so these values govern the
             ball-floor contact. -->
        <body name="ball" pos="0 0 0.3">
            <freejoint name="ball_free"/>
            <inertial pos="0 0 0" mass="1.0" diaginertia="0.06 0.06 0.06"/>
            <geom type="sphere" name="ball_geom" size="0.3" rgba="0.82 0.12 0.16 1"
                  condim="6" friction="1.0 0.01 0.001"/>
        </body>
    </worldbody>
</mujoco>
